    function createFilterUI() {
    const filterContainer = document.getElementById('filters');
    const existingFilters = Array.from(document.querySelectorAll('.filter')).map(input => input.value);

    // Find unique categories from the places data
    let uniqueCategories = new Set(allPlaces.map(place => place.category));

    uniqueCategories.forEach(category => {
        if (!existingFilters.includes(category)) {  // Only add if it's missing
            const label = document.createElement('label');
            label.innerHTML = `
                <input type="checkbox" class="filter" value="${category}" checked> ${capitalize(category)}
            `;
            filterContainer.appendChild(label);
        }
    });
    // Reattach event listeners to all filters (new and existing)
        document.querySelectorAll('.filter').forEach(input => {
        input.removeEventListener('change', updateMap);  // Prevent duplicate listeners
        input.addEventListener('change', updateMap);
    });
}


    // Function to update map based on selected filters
    function updateMap() {
        // Remove existing markers
        markers.forEach(marker => map.removeLayer(marker));
        markers = [];

        const categoryColors = {
            "museum": "red",
            "festival": "blue"
        };

        // Get selected filters
        let selectedFilters = Array.from(document.querySelectorAll('.filter:checked'))
                                .map(input => input.value);

        // Add markers for filtered places
        allPlaces.forEach(place => {
        if (selectedFilters.includes(place.category)) {
            // Get the corresponding color for the category
            let markerColor = categoryColors[place.category] || "gray"; // Default to gray if not found

            // Create a custom icon
            let customIcon = L.icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-${markerColor}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });

            // Create the marker with the custom icon
            let marker = L.marker([place.latitude, place.longitude], { icon: customIcon }).addTo(map);
            
            marker.bindPopup(`
                <strong>${place.title}</strong><br>
                ${place.description}<br><br>
                <b>Σχετικά link:</b><br>
                <ul>
                    <li><a href="${place['youtube']}" target="_blank"> YouTube </a></li>
                    <li><a href="${place['google']}" target="_blank"> Google </a></li>
                    <li><a href="${place['visitgreece']}" target="_blank"> Visit Greece </a></li>
                </ul>
            `);
            markers.push(marker);
        }
        });
    }

    // Helper function to capitalize first letter of category names
    function capitalize(str) {
        return str.charAt(0).toUpperCase() + str.slice(1);
    }
</script>
<script>
    // Fetch places.json data
    fetch('/places')
        .then(response => response.json())
        .then(places => {
            const carouselSlide = document.querySelector('.carousel-slide');
            const carouselDots = document.querySelector('.carousel-dots');
            let currentIndex = 0;

            // Dynamically create carousel items and dots
            places.forEach((place, index) => {
                // Create carousel item (card)
                const carouselItem = document.createElement('div');
                carouselItem.classList.add('carousel-item');
                carouselItem.innerHTML = `
                    <div class="card">
                        <img src="${place.image}" alt="${place.title}">
                        <h4>${place.title}</h4>
                        <p>${place.detailedDescription}</p>

                        <br>
                        <a href="${place['google']}" target="_blank"style="background-color: #007BFF; font-weight:bold">Google</a> 

                        <a href="${place['youtube']}" target="_blank" style="background-color: red; font-weight:bold">YouTube</a> 

                        <a href="${place['visitgreece']}" target="_blank" style="background-color: #33fff9; font-weight:bold; color: black">Visit Greece</a>

                    </div>
                `;
                carouselSlide.appendChild(carouselItem);

                // Create dot for each item
                const dot = document.createElement('span');
                dot.classList.add('dot');
                if (index === 0) dot.classList.add('active-dot');
                dot.addEventListener('click', () => moveToSlide(index));
                carouselDots.appendChild(dot);
            });

            const totalItems = places.length;
            const dots = document.querySelectorAll('.dot');

            // Function to move to the next or previous slide
            function moveToSlide(index) {
                if (index >= totalItems) currentIndex = 0;
                else if (index < 0) currentIndex = totalItems - 1;
                else currentIndex = index;

                // Move the slide
                carouselSlide.style.transform = `translateX(-${currentIndex * 100}%)`;

                // Update active dot
                dots.forEach(dot => dot.classList.remove('active-dot'));
                dots[currentIndex].classList.add('active-dot');
            }

            // Previous and Next button functionality
            document.querySelector('.prev').addEventListener('click', () => moveToSlide(currentIndex - 1));
            document.querySelector('.next').addEventListener('click', () => moveToSlide(currentIndex + 1));

        })
        .catch(error => {
            console.error('Error fetching places:', error);
        });
</script>
