<script src="https://unpkg.com/leaflet@1.0.3/dist/leaflet.js"></script>
<script>
    let map = L.map('map').setView([37.59, 22.04], 8);
    let OpenStreetMap_Mapnik = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        minZoom: 6,
        attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    let allPlaces = [];  // Store all places globally
    let markers = [];     // Store markers for filtering
    let uniqueCategories = new Set();  // Store unique categories dynamically

    // Fetch places
    fetch('/places')
        .then(response => response.json())
        .then(data => {
            allPlaces = data;

            // Extract unique categories
            data.forEach(place => uniqueCategories.add(place.category));

            // Generate filter checkboxes dynamically
            createFilterUI();

            // Initially display all markers
            updateMap();
        })
        .catch(err => console.error('Failed to load places:', err));

    // Function to create filter checkboxes dynamically
    // function createFilterUI() {
