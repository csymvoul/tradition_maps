<!DOCTYPE html>
<html lang="el">
<head><%- include('../partials/head') %></head>
<body class="d-flex flex-column" style="min-height:100vh;">

<%- include('../partials/header') %>

<div id="map-wrapper">
  <!-- Filter + Search overlay (top-center, horizontal) -->
  <div id="filter-panel">
    <input id="map-search" type="text" class="form-control form-control-sm"
      placeholder="🔍 Αναζήτηση…" style="min-width:130px;border-radius:20px;" />
    <div class="filter-sep"></div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="festival" id="f-festival" checked>
      <label class="form-check-label" for="f-festival"><span class="badge badge-festival">Φεστιβάλ</span></label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="museum" id="f-museum" checked>
      <label class="form-check-label" for="f-museum"><span class="badge badge-museum">Μουσείο</span></label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="church" id="f-church" checked>
      <label class="form-check-label" for="f-church"><span class="badge badge-church">Εκκλησία</span></label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="music" id="f-music" checked>
      <label class="form-check-label" for="f-music"><span class="badge badge-music">Μουσική</span></label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="dance" id="f-dance" checked>
      <label class="form-check-label" for="f-dance"><span class="badge badge-dance">Χορός</span></label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="food" id="f-food" checked>
      <label class="form-check-label" for="f-food"><span class="badge badge-food">Φαγητό</span></label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" value="custom" id="f-custom" checked>
      <label class="form-check-label" for="f-custom"><span class="badge badge-custom">Άλλο</span></label>
    </div>
    <div class="filter-sep"></div>
    <button id="locate-btn" class="btn btn-outline-dark btn-sm" style="border-radius:20px;white-space:nowrap;">
      <i class="bi bi-crosshair me-1"></i>Κοντά μου
    </button>
  </div>

  <div id="map"></div>

  <!-- Side panel -->
  <div id="side-panel">
    <div class="panel-header d-flex justify-content-between align-items-start">
      <div>
        <h5 id="sp-name" class="mb-1 fw-bold"></h5>
        <small id="sp-region" class="text-muted"></small>
      </div>
      <button class="btn btn-sm btn-light ms-2 flex-shrink-0" id="sp-close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <div class="panel-body">
      <p id="sp-desc" class="text-muted mb-3" style="font-size:0.9rem;"></p>
      <h6 class="fw-semibold mb-2">Παραδόσεις</h6>
      <div id="sp-traditions"></div>
      <a id="sp-link" href="#" class="btn btn-dark btn-sm mt-3 w-100">
        <i class="bi bi-arrow-right-circle me-1"></i>Δείτε Περισσότερα
      </a>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
<script>
const CATEGORY_LABELS = {
  festival:'Φεστιβάλ', museum:'Μουσείο', church:'Εκκλησία',
  music:'Μουσική', dance:'Χορός', food:'Φαγητό', custom:'Άλλο'
};

const map = L.map('map', { zoomControl: true }).setView([38.5, 23.0], 6);
L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
  attribution: '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
  subdomains: 'abcd', maxZoom: 19
}).addTo(map);

const clusterGroup = L.markerClusterGroup({ maxClusterRadius: 50 });
map.addLayer(clusterGroup);

let allPlaces = [], activeFilters = new Set(['festival','museum','church','music','dance','food','custom']);
let searchQuery = '', markerMap = {}, userMarker = null;

// Side panel
const panel = document.getElementById('side-panel');
document.getElementById('sp-close').addEventListener('click', () => panel.classList.remove('open'));

function openPanel(place) {
  document.getElementById('sp-name').textContent = place.name;
  document.getElementById('sp-region').textContent = place.region || '';
  document.getElementById('sp-desc').textContent = place.description || '';
  document.getElementById('sp-link').href = '/place/' + place.id;
  const container = document.getElementById('sp-traditions');
  container.innerHTML = '';
  (place.traditions || []).forEach(t => {
    const cat = t.category || 'custom';
    container.innerHTML += `
      <div class="tradition-card">
        <span class="badge badge-${cat} mb-1">${CATEGORY_LABELS[cat]}</span>
        <div class="fw-semibold">${t.name}</div>
        <small class="text-muted">${(t.description||'').substring(0,120)}${t.description?.length>120?'…':''}</small>
      </div>`;
  });
  panel.classList.add('open');
}

function placeCategories(place) {
  return new Set((place.traditions||[]).map(t => t.category||'custom'));
}

function matchesSearch(place) {
  if (!searchQuery) return true;
  const q = searchQuery.toLowerCase();
  if (place.name.toLowerCase().includes(q)) return true;
  if ((place.region||'').toLowerCase().includes(q)) return true;
  return (place.traditions||[]).some(t => (t.name||'').toLowerCase().includes(q));
}

function makeMarker(place) {
  const count = (place.traditions||[]).length;
  const icon = L.divIcon({
    className: '',
    html: `<div class="place-marker">${count}</div>`,
    iconSize: [36,36], iconAnchor: [18,18]
  });
  const marker = L.marker([place.latitude, place.longitude], { icon });
  marker.bindTooltip(place.name, { permanent:false, direction:'top', offset:[0,-20] });
  marker.on('click', () => openPanel(place));
  return marker;
}

function redrawMarkers() {
  clusterGroup.clearLayers();
  allPlaces.forEach(place => {
    const cats = placeCategories(place);
    const visible = [...cats].some(c => activeFilters.has(c)) && matchesSearch(place);
    if (visible) clusterGroup.addLayer(markerMap[place.id]);
  });
}

async function loadPlaces() {
  try {
    const res = await fetch('/api/places');
    allPlaces = await res.json();
    allPlaces.forEach(p => { markerMap[p.id] = makeMarker(p); });
    redrawMarkers();
  } catch(e) { console.error('Failed to load places', e); }
}

// Category filters
document.querySelectorAll('#filter-panel input[type=checkbox]').forEach(cb => {
  cb.addEventListener('change', () => {
    if (cb.checked) activeFilters.add(cb.value); else activeFilters.delete(cb.value);
    redrawMarkers();
  });
});

// Search
document.getElementById('map-search').addEventListener('input', function() {
  searchQuery = this.value.trim();
  redrawMarkers();
});

// Locate me
document.getElementById('locate-btn').addEventListener('click', () => {
  if (!navigator.geolocation) return alert('Η γεωτοποθεσία δεν υποστηρίζεται από τον browser σας.');
  navigator.geolocation.getCurrentPosition(pos => {
    const { latitude: lat, longitude: lng } = pos.coords;
    map.setView([lat, lng], 10);
    if (userMarker) map.removeLayer(userMarker);
    userMarker = L.circleMarker([lat, lng], {
      radius: 9, fillColor: '#ef4444', color: '#fff', weight: 3, fillOpacity: 1
    }).addTo(map).bindPopup('📍 Εδώ βρίσκεστε').openPopup();
  }, () => alert('Δεν ήταν δυνατή η εύρεση τοποθεσίας σας.'));
});

loadPlaces();
</script>
</body>
</html>
