<!DOCTYPE html>
<html lang="el">
<head><%- include('../partials/head') %>
<style>
  #map-belt { height: 240px; width: 100%; }
  .tradition-gallery { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; }
  .tradition-gallery img {
    height:90px; width:90px; object-fit:cover; border-radius:8px;
    cursor:pointer; border:2px solid transparent; transition:border-color .2s;
  }
  .tradition-gallery img:hover { border-color:#1d4ed8; }
  .tradition-gallery img.active { border-color:#1d4ed8; }

  /* Lightbox */
  #lightbox {
    display:none; position:fixed; inset:0; z-index:9999;
    background:rgba(0,0,0,0.92); align-items:center; justify-content:center;
  }
  #lightbox.open { display:flex; }
  #lb-img { max-width:90vw; max-height:85vh; object-fit:contain; border-radius:8px; }
  .lb-btn {
    position:absolute; background:none; border:none; color:#fff;
    font-size:2.2rem; cursor:pointer; opacity:0.8; transition:opacity .2s; line-height:1;
    padding:12px;
  }
  .lb-btn:hover { opacity:1; }
  #lb-close { top:12px; right:16px; font-size:2rem; }
  #lb-prev  { left:8px; top:50%; transform:translateY(-50%); }
  #lb-next  { right:8px; top:50%; transform:translateY(-50%); }
  #lb-counter { position:absolute; bottom:14px; left:50%; transform:translateX(-50%); color:#ccc; font-size:0.85rem; }

  /* Back to top */
  #back-to-top {
    position:fixed; bottom:24px; right:24px; z-index:998;
    width:40px; height:40px; border-radius:50%; background:#1a1a2e; color:#fff;
    border:none; font-size:1rem; cursor:pointer; display:none;
    align-items:center; justify-content:center;
    box-shadow:0 2px 12px rgba(0,0,0,0.25); transition:opacity .2s;
  }
</style>
</head>
<body class="d-flex flex-column" style="min-height:100vh;">

<%- include('../partials/header') %>

<main class="flex-grow-1">

  <!-- Place info -->
  <div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Αρχική</a></li>
        <li class="breadcrumb-item"><a href="/info">Μέρη</a></li>
        <li class="breadcrumb-item active"><%= place.name %></li>
      </ol>
    </nav>
    <h1 class="fw-bold mb-2"><%= place.name %></h1>
    <% if (place.region) { %>
      <span class="badge bg-secondary mb-3"><i class="bi bi-geo-alt me-1"></i><%= place.region %></span>
    <% } %>
    <p class="text-muted" style="max-width:720px;"><%= place.description || '' %></p>
    <div>
      <span class="fw-semibold me-2">Παραδόσεις:</span>
      <span class="badge bg-dark"><%= place.traditions.length %></span>
    </div>
  </div>

  <!-- Map belt -->
  <div id="map-belt"></div>

  <!-- Traditions -->
  <div class="container py-5">
    <h3 class="fw-bold mb-4">Παραδόσεις</h3>

    <% if (place.traditions.length === 0) { %>
      <p class="text-muted">Δεν υπάρχουν καταχωρημένες παραδόσεις ακόμα.</p>
    <% } else { %>
      <div class="row g-4">
        <% place.traditions.forEach(function(t, tIdx) {
          const catLabels = {festival:'Φεστιβάλ',museum:'Μουσείο',church:'Εκκλησία',
            music:'Μουσική',dance:'Χορός',food:'Φαγητό',custom:'Άλλο'};
          const cat = t.category || 'custom';
          const imgs = (t.images && t.images.length > 0) ? t.images : (t.image ? [t.image] : []);
        %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0" style="border-radius:12px;overflow:hidden;">

              <!-- Image display -->
              <% if (imgs.length > 0) { %>
                <div style="position:relative;">
                  <img id="main-img-<%= tIdx %>" src="<%= imgs[0] %>" alt="<%= t.name %>"
                    loading="lazy" style="height:200px;object-fit:cover;width:100%;cursor:zoom-in;"
                    data-imgs='<%- JSON.stringify(imgs) %>'
                    onclick="openLightbox(JSON.parse(this.dataset.imgs), 0)" />
                </div>
              <% } else { %>
                <div class="bg-light d-flex align-items-center justify-content-center" style="height:120px;">
                  <i class="bi bi-music-note-beamed text-muted" style="font-size:2.5rem;"></i>
                </div>
              <% } %>

              <div class="card-body d-flex flex-column">
                <span class="badge badge-<%= cat %> mb-2 align-self-start"><%= catLabels[cat]||cat %></span>
                <h5 class="card-title fw-bold"><%= t.name %></h5>
                <p class="card-text text-muted flex-grow-1" style="font-size:0.9rem;"><%= t.description||'' %></p>

                <!-- Thumbnail gallery (if multiple images) -->
                <% if (imgs.length > 1) { %>
                  <div class="tradition-gallery mb-2" data-imgs='<%- JSON.stringify(imgs) %>'>
                    <% imgs.forEach(function(url, iIdx) { %>
                      <img src="<%= url %>" loading="lazy" class="<%= iIdx===0?'active':'' %>"
                        data-iidx="<%= iIdx %>"
                        onclick="switchImg(<%= tIdx %>, this); openLightbox(JSON.parse(this.closest('.tradition-gallery').dataset.imgs), parseInt(this.dataset.iidx))" />
                    <% }); %>
                  </div>
                <% } %>

                <% if (t.detailedDescription) { %>
                  <button class="btn btn-outline-secondary btn-sm mb-3 mt-1"
                    type="button" data-bs-toggle="collapse" data-bs-target="#detail-<%= t.id %>">
                    <i class="bi bi-chevron-down me-1"></i>Αναλυτική Περιγραφή
                  </button>
                  <div class="collapse mb-3" id="detail-<%= t.id %>">
                    <div class="card card-body border-0 bg-light" style="font-size:0.85rem;">
                      <%- t.detailedDescription %>
                    </div>
                  </div>
                <% } %>

                <div class="d-flex gap-2 flex-wrap mt-auto">
                  <% if (t.youtube) { %>
                    <a href="<%= t.youtube %>" target="_blank" class="btn btn-danger btn-sm">
                      <i class="bi bi-youtube me-1"></i>YouTube
                    </a>
                  <% } %>
                  <% if (t.google) { %>
                    <a href="<%= t.google %>" target="_blank" class="btn btn-primary btn-sm">
                      <i class="bi bi-search me-1"></i>Google
                    </a>
                  <% } %>
                  <% if (t.visitgreece) { %>
                    <a href="<%= t.visitgreece %>" target="_blank" class="btn btn-success btn-sm">
                      <i class="bi bi-globe me-1"></i>Visit Greece
                    </a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <div class="mt-5">
      <a href="/info" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left me-1"></i>Πίσω στα Μέρη
      </a>
    </div>
  </div>
</main>

<!-- Lightbox overlay -->
<div id="lightbox">
  <button class="lb-btn" id="lb-close" onclick="closeLightbox()">×</button>
  <button class="lb-btn" id="lb-prev" onclick="lbNav(-1)">&#8249;</button>
  <img id="lb-img" src="" alt="" />
  <button class="lb-btn" id="lb-next" onclick="lbNav(1)">&#8250;</button>
  <div id="lb-counter"></div>
</div>

<!-- Back to top -->
<button id="back-to-top" title="Επιστροφή στην αρχή" onclick="window.scrollTo({top:0,behavior:'smooth'})">
  <i class="bi bi-chevron-up"></i>
</button>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // Map belt
  const map = L.map('map-belt', {
    zoomControl:false, attributionControl:false,
    dragging:false, scrollWheelZoom:false, doubleClickZoom:false
  }).setView([<%= place.latitude %>, <%= place.longitude %>], 9);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { subdomains:'abcd' }).addTo(map);
  L.circleMarker([<%= place.latitude %>, <%= place.longitude %>], {
    radius:10, fillColor:'#1d4ed8', color:'#fff', weight:3, fillOpacity:1
  }).addTo(map).bindTooltip('<%= place.name %>', { permanent:true, direction:'top', offset:[0,-14] });

  // Gallery thumbnail switcher (reads URL from the thumb element itself)
  function switchImg(tIdx, thumb) {
    document.getElementById('main-img-' + tIdx).src = thumb.src;
    thumb.closest('.tradition-gallery').querySelectorAll('img').forEach(i => i.classList.remove('active'));
    thumb.classList.add('active');
  }

  // ── Lightbox ──
  let lbImages = [], lbIndex = 0;
  function openLightbox(images, index) {
    lbImages = images; lbIndex = index;
    updateLb();
    document.getElementById('lightbox').classList.add('open');
  }
  function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); }
  function lbNav(dir) { lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length; updateLb(); }
  function updateLb() {
    document.getElementById('lb-img').src = lbImages[lbIndex];
    document.getElementById('lb-counter').textContent = (lbIndex+1) + ' / ' + lbImages.length;
    document.getElementById('lb-prev').style.display = lbImages.length > 1 ? '' : 'none';
    document.getElementById('lb-next').style.display = lbImages.length > 1 ? '' : 'none';
  }
  document.getElementById('lightbox').addEventListener('click', function(e) {
    if (e.target === this) closeLightbox();
  });
  document.addEventListener('keydown', e => {
    if (!document.getElementById('lightbox').classList.contains('open')) return;
    if (e.key === 'ArrowLeft')  lbNav(-1);
    if (e.key === 'ArrowRight') lbNav(1);
    if (e.key === 'Escape')     closeLightbox();
  });

  // ── Back to top ──
  window.addEventListener('scroll', function() {
    const btn = document.getElementById('back-to-top');
    btn.style.display = window.scrollY > 300 ? 'flex' : 'none';
  });
</script>
</body>
</html>
